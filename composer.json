{
    "name": "rushing/laravel-data-schemas-scribe",
    "description": "Scribe bridge that drives request/response extraction from Laravel Data classes via rushing/laravel-data-schemas",
    "keywords": [
        "laravel",
        "scribe",
        "openapi",
        "json-schema",
        "spatie",
        "laravel-data"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Stephen Rushing",
            "email": "stephen@rushing.dev"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "knuckleswtf/scribe": "^4.0|^5.0",
        "schemastud/laravel-data-schemas": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Rushing\\LaravelDataSchemasScribe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rushing\\LaravelDataSchemasScribe\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rushing\\LaravelDataSchemasScribe\\LaravelDataSchemasScribeServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../../vendor/rushing/laravel-data-schemas",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
